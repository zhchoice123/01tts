[Unit]
Description=Listening Lab Spring Boot API
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/java -jar /root/tts-server-0.1.0.jar --server.address=0.0.0.0 --server.port=8080
Restart=always
RestartSec=5
StandardOutput=append:/root/logs/tts-server.log
StandardError=append:/root/logs/tts-server.log

[Install]
WantedBy=multi-user.target
