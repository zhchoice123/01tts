[Unit]
Description=Listening Lab unified Python API
After=network-online.target redis.service mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=01tts
Group=01tts
WorkingDirectory=/opt/01tts/01tts-worker
EnvironmentFile=/etc/01tts-python-api.env
ExecStart=/opt/01tts/venv/bin/uvicorn api:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
