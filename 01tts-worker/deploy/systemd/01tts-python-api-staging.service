[Unit]
Description=Listening Lab unified Python API staging
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=01tts
Group=01tts
WorkingDirectory=/opt/01tts/01tts-worker
EnvironmentFile=/etc/01tts-python-api-staging.env
ExecStart=/opt/01tts/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8081 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
